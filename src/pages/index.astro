---
import { getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { btnBase } from "../components/button";
import { buttonClass } from "../components/ui/button";
import LandingChallenges from "../components/LandingChallenges.astro";
import HeroCalendar from "../components/HeroCalendar.astro";
import TeamCountStyles from "../components/TeamCountStyles.astro";
import { tracks } from "../data/challenges";
import hero from "../assets/junction-2026-hero.jpg";

// Hero image: the LCP element. It is object-cover in a box that is 100vw wide and
// max(78svh, 380px) tall, so with the 1920x1200 source (aspect 1.6) it renders at
// max(100vw, 124.8vh, 608px) and is wider than the viewport on portrait screens (vh rather
// than svh in `sizes`: never smaller, so it never picks a too-small file). Quality per format was picked by comparing 1:1 crops with the source (AVIF
// below q45 flattens the painted texture). Quality is part of the hashed filenames, so
// changing it here also changes the long-cached URLs.
const heroWidths = [640, 960, 1280, 1600, 1920];
const heroSizes = "max(100vw, 124.8vh, 608px)";
const [heroAvif, heroWebp, heroJpg] = await Promise.all([
  getImage({ src: hero, widths: heroWidths, format: "avif", quality: 45 }),
  getImage({ src: hero, widths: heroWidths, format: "webp", quality: 72 }),
  getImage({ src: hero, widths: heroWidths, format: "jpg", quality: 72 }),
]);

// The original's `<Button asChild className={btnBase + "..."}>`: shadcn's default variant with
// these classes merged over it (tailwind-merge drops h-9, px-4, py-2, bg-primary, ...).
const heroCta = buttonClass({ className: btnBase + " h-auto max-w-full whitespace-normal bg-highlight px-6 py-5 font-mono text-xl text-highlight-foreground hover:bg-highlight/90 sm:px-10 sm:text-2xl md:px-12 md:text-4xl" });

const eventJsonLd = { "@type": "Event", name: "Junction 2026", description: "Junction 2026 – European Tech Renaissance hackathon", startDate: "2026-11-13", endDate: "2026-11-15", eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode", location: { "@type": "Place", name: "Hype Areena", address: "Espoo, Finland" }, url: "https://junction2026.com" };
const websiteJsonLd = { "@type": "WebSite", name: "Junction 2026 Challenges", alternateName: "Junction 2026", url: "https://junction2026.com/" };
const jsonLd = { "@context": "https://schema.org", "@graph": [eventJsonLd, websiteJsonLd] };
---

<BaseLayout
  title="Junction 2026 Challenges"
  description="Junction 2026 challenges in compact and agent friendly format"
  ogTitle="Junction 2026 Challenges"
  ogDescription="Junction 2026 challenges in compact and agent friendly format"
  keywords="Junction 2026, Junction hackathon 2026, Junction 2026 challenges, Junction 2026 Espoo, hackathon Finland 2026, Europe's biggest hackathon"
  jsonLd={jsonLd}
  preloadFonts={{ titilliumWeb: [300], spaceMono: [700, 400] }}
>
  <TeamCountStyles slot="head" />
  <main>
    <section class="relative h-[78svh] min-h-[380px] overflow-hidden">
      <picture>
        <source type="image/avif" srcset={heroAvif.srcSet.attribute} sizes={heroSizes} />
        <source type="image/webp" srcset={heroWebp.srcSet.attribute} sizes={heroSizes} />
        <img src={heroJpg.src} srcset={heroJpg.srcSet.attribute} sizes={heroSizes} width={1920} height={1200} alt="Junction 2026 – European Tech Renaissance, Nov 13–15 2026, Espoo, Finland" class="absolute inset-0 h-full w-full object-cover" loading="eager" fetchpriority="high" />
      </picture>
      <div class="absolute inset-0 bg-background/45" aria-hidden="true"></div>
      <div class="relative flex h-full flex-col items-center justify-center gap-6 px-6 pt-16 text-center">
        <h1 class="font-mono text-3xl font-bold uppercase tracking-[0.3em] md:text-5xl">Junction 2026</h1>
        <a href="/challenges" class={heroCta}>VIEW CHALLENGES HERE →</a>
        <div class="flex max-w-3xl flex-wrap justify-center gap-2">
          {tracks.map((t) => (
            <a href={`/challenges#${t.slug}`} class="border border-border bg-background/60 px-3 py-1.5 font-mono text-xs uppercase hover:border-highlight hover:text-highlight">{t.name.replace(" Track", "")} · {t.challenges.length}</a>
          ))}
        </div>
      </div>
      <HeroCalendar />
    </section>
    <LandingChallenges />
  </main>
</BaseLayout>
