---
// Document shell and shared <head>, ported from the original src/routes/__root.tsx.
// Per-page meta overrides the root meta of the same name, as TanStack's head() merging did.
import { Font } from "astro:assets";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import CookieNotice from "../components/CookieNotice.astro";
import "../styles/global.css";

type Weight = 300 | 400 | 600 | 700;

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  keywords?: string;
  /** JSON-LD object, rendered as an inert application/ld+json data block. */
  jsonLd?: Record<string, unknown>;
  /**
   * Font faces to preload: only those visible above the fold on this page
   * (at most two or three, so they do not compete with the hero image).
   */
  preloadFonts?: { titilliumWeb?: Weight[]; spaceMono?: (400 | 700)[] };
  /**
   * Whether the page has a Markdown twin (built by src/integrations/markdown-twins.ts) to
   * announce with <link rel="alternate">. Only the 404 page has none.
   */
  markdown?: boolean;
}

const {
  title = "Junction 2026",
  description = "Junction 2026 – Europe's biggest hackathon, 13–15 Nov, Espoo.",
  ogTitle,
  ogDescription,
  keywords,
  jsonLd,
  preloadFonts = {},
  markdown = true,
} = Astro.props;

// The page's Markdown twin: /index.md for the home page, otherwise the page URL plus ".md".
// (In the build, Astro.url.pathname is the output file, e.g. /about.html or /index.html.)
const pagePath = Astro.url.pathname.replace(/\.html$/, "").replace(/\/(index)?$/, "");
const markdownHref = markdown ? new URL(`${pagePath || "/index"}.md`, Astro.site).href : undefined;
// The page's public URL, as listed in sitemap.xml: the site root for the home page, otherwise
// without ".html" and without trailing slash. The 404 page (served for any unknown URL) has none.
const pageUrl = pagePath === "/404" ? undefined : new URL(pagePath || "/", Astro.site).href;

// Every configured face is latin/normal (astro.config.mjs), so weight alone selects a file.
const toPreload = (weights: readonly number[] = []) =>
  weights.map((weight) => ({ weight, style: "normal" as const }));

// Prefetch/prerender same-origin links on hover (desktop) or viewport heuristics (mobile),
// so navigation stays instant without a client-side router. Inert JSON, not executed JS.
// https://developer.chrome.com/docs/web-platform/prerender-pages
const speculationRules = {
  prerender: [{ where: { href_matches: "/*" }, eagerness: "moderate" }],
  prefetch: [{ where: { href_matches: "/*" }, eagerness: "moderate" }],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    {ogTitle && <meta property="og:title" content={ogTitle} />}
    {ogDescription && <meta property="og:description" content={ogDescription} />}
    {keywords && <meta name="keywords" content={keywords} />}
    {pageUrl && <link rel="canonical" href={pageUrl} />}
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    {markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} />}
    <Font cssVariable="--font-titillium-web" preload={toPreload(preloadFonts.titilliumWeb)} />
    <Font cssVariable="--font-space-mono" preload={toPreload(preloadFonts.spaceMono)} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline type="speculationrules" set:html={JSON.stringify(speculationRules)} />
    <slot name="head" />
  </head>
  <body>
    <CookieNotice />
    <SiteHeader />
    <slot />
    <SiteFooter />
  </body>
</html>
