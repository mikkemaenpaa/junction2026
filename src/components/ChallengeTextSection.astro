---
import type { ChallengeTextSection } from "../data/challenge-text";

interface Props {
  section: ChallengeTextSection;
}

const { section } = Astro.props;
---

<section class="border-t border-border py-6">
  {section.eyebrow && <p class="mb-2 text-xs uppercase tracking-wider text-muted-foreground">{section.eyebrow}</p>}
  <h2 class="mb-5 text-2xl font-semibold">{section.title}</h2>
  <div class="challenge-prose leading-relaxed text-muted-foreground" set:html={section.html} />
</section>

<style>
  .challenge-prose { overflow-wrap: anywhere; }
  .challenge-prose :global(p + p),
  .challenge-prose :global(p + ul),
  .challenge-prose :global(p + ol),
  .challenge-prose :global(ul + p),
  .challenge-prose :global(ol + p),
  .challenge-prose :global(div + div),
  .challenge-prose :global(li + li) { margin-top: 1rem; }
  .challenge-prose :global(h3),
  .challenge-prose :global(h4),
  .challenge-prose :global(h5),
  .challenge-prose :global(h6) { margin: 1.75rem 0 0.75rem; color: var(--foreground); font-weight: 600; }
  .challenge-prose :global(h3) { font-size: 1.25rem; }
  .challenge-prose :global(h4) { font-size: 1.125rem; }
  .challenge-prose :global(ul) { list-style: disc; padding-left: 1.5rem; }
  .challenge-prose :global(ol) { list-style: decimal; padding-left: 1.5rem; }
  .challenge-prose :global(a) { text-decoration: underline; text-underline-offset: 0.2em; }
  .challenge-prose :global(a:hover) { color: var(--highlight); }
  .challenge-prose :global(strong) { color: var(--foreground); font-weight: 600; }
  .challenge-prose :global(blockquote) { margin: 1rem 0; border-left: 2px solid var(--border); padding-left: 1rem; }
  .challenge-prose :global(pre) { margin: 1rem 0; max-width: 100%; overflow-x: auto; border: 1px solid var(--border); padding: 1rem; }
  .challenge-prose :global(code) { font-family: var(--font-mono); font-size: 0.85em; }
  .challenge-prose :global(pre code) { overflow-wrap: normal; }
  .challenge-prose :global(li > div > span + span) { margin-left: 0.25em; }
</style>
