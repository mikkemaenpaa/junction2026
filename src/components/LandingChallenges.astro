---
// Every challenge (main and tech) as a card linking to its detail page, shown on the home page
// under the hero. Ported from the original src/components/landing-challenges.tsx.
// Logos are lazy-loaded (PartnerIdentity) and the backdrop too, so the 38 cards do not compete
// with the hero image.
import AbstractBackdrop from "./AbstractBackdrop.astro";
import PartnerIdentity from "./PartnerIdentity.astro";
import LucideIcon from "./LucideIcon.astro";
import { buttonClass } from "./ui/button";
import { challengeDirectory } from "../data/challenge-directory";
---

<section class="challenge-directory landing-challenges px-5 pb-16 pt-6 text-foreground sm:px-8" aria-labelledby="landing-challenges-title">
  <AbstractBackdrop lazy sizes="1536px" />
  <div class="mx-auto max-w-6xl">
    <header class="mb-6 flex flex-wrap items-center justify-between gap-3">
      <h2 id="landing-challenges-title" class="text-2xl font-semibold">Challenges <span class="ml-2 text-base font-normal text-muted-foreground">{challengeDirectory.length}</span></h2>
      <a href="/challenges" class={buttonClass({ variant: "link", className: "h-auto p-0 text-muted-foreground" })}>All challenges <LucideIcon name="arrow-up-right" /></a>
    </header>
    <div class="grid gap-4 lg:grid-cols-2">
      {challengeDirectory.map(({ challenge, slug, track }) => (
        <a href={`/challenges/${slug}`} class="challenge-row group grid min-w-0 gap-5 p-5 transition-colors hover:border-highlight focus-visible:outline-2 focus-visible:outline-highlight sm:grid-cols-[130px_minmax(0,1fr)] sm:p-6">
          <div class="max-w-40 self-center"><PartnerIdentity name={challenge.org} /></div>
          <div class="min-w-0">
            <p class="text-xs text-muted-foreground">{track}</p>
            <div class="mt-2 flex items-start justify-between gap-3">
              <h3 class="text-xl font-semibold leading-snug group-hover:text-highlight">{challenge.title}</h3>
              <LucideIcon name="arrow-up-right" class="mt-1 size-4 shrink-0 text-muted-foreground" />
            </div>
            <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-muted-foreground">{challenge.task}</p>
            <p class="mt-4 line-clamp-2 border-t border-border pt-3 text-sm text-muted-foreground"><span class="text-foreground">Prizes: </span>{challenge.prizes}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
