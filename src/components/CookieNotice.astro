---
// Cookie notice, fixed to the bottom of the viewport. In the HTML it is `hidden`; the script
// (src/scripts/consent.ts) shows it while the visitor has not answered, and the "Cookie
// settings" button in SiteFooter reopens it. Without JavaScript it stays hidden and nothing
// loads. BaseLayout renders it first in <body>, so it is the first stop for keyboard and
// screen reader users, and outside <main>, so it never reaches the Markdown twins.
//
// Consent is asked per purpose: "Accept all" and "Reject all" are the same button (equal size
// and weight, neither preselected), and "Choose" opens one unticked checkbox per purpose plus
// "Save choice". Saving with nothing ticked is the same as "Reject all".
const choiceButton =
  "min-w-28 cursor-pointer border border-foreground/40 px-5 py-2.5 font-mono text-xs font-bold uppercase tracking-wider text-foreground transition-colors hover:bg-foreground hover:text-background focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-highlight";
const focusRing = "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-highlight";
const purposes = [
  { name: "analytics", label: "Analytics", text: "Count visits with Google Analytics." },
  { name: "advertising", label: "Advertising", text: "Let Google use that data to measure and personalise its ads." },
];
---

<section
  id="cookie-notice"
  aria-label="Cookie notice"
  tabindex="-1"
  hidden
  data-nosnippet
  class="fixed inset-x-0 bottom-0 z-50 max-h-[85dvh] overflow-y-auto border-t border-border bg-background/90 pt-4 pb-[max(1rem,env(safe-area-inset-bottom))] pl-[max(1.5rem,env(safe-area-inset-left))] pr-[max(1.5rem,env(safe-area-inset-right))] backdrop-blur focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-highlight"
>
  <div class="mx-auto max-w-6xl">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between sm:gap-8">
      <p class="text-sm leading-relaxed">
        We'd like to use Google cookies for two things: counting visits (analytics) and
        measuring and personalising Google ads (advertising). Nothing is set unless you
        accept. <a href="/privacy" class="whitespace-nowrap underline underline-offset-4 hover:text-highlight">Privacy and cookies</a>
      </p>
      <div class="grid shrink-0 grid-cols-2 gap-3">
        <button type="button" value="all" class={choiceButton}>Accept all</button>
        <button type="button" value="none" class={choiceButton}>Reject all</button>
      </div>
    </div>
    <details class="mt-3 text-sm">
      <summary class={`w-fit cursor-pointer font-mono text-xs uppercase tracking-wider hover:text-highlight ${focusRing}`}>Choose</summary>
      <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-8">
        {purposes.map((p) => (
          <label class="flex cursor-pointer items-start gap-3">
            <input type="checkbox" name={p.name} class={`mt-1 size-4 shrink-0 cursor-pointer accent-highlight ${focusRing}`} />
            <span>
              <span class="font-semibold">{p.label}</span>
              <span class="block text-muted-foreground">{p.text}</span>
            </span>
          </label>
        ))}
        <button type="button" value="save" class={`${choiceButton} self-start sm:ml-auto sm:self-center`}>Save choice</button>
      </div>
    </details>
  </div>
</section>

<script>
  import "../scripts/consent";
</script>
