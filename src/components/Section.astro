---
interface Props {
  label: string;
  title: string;
}

const { label, title } = Astro.props;
---

<section class="mx-auto max-w-6xl px-6 py-20">
  <p class="label-mono">// {label}</p>
  <h2 class="mt-3 font-display text-4xl font-bold uppercase md:text-5xl">{title}</h2>
  <div class="mt-10"><slot /></div>
</section>
