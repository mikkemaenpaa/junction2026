---
// Site footer: one glass bar with the lockup, the tagline, the page's sections and "Get started"
// (the page in front of the platform). Self-contained (no hero.css): the styles below copy the
// hero's chip and send button states.
import { EspooLockup } from '@/components/landing/EspooLockup'
import { GET_STARTED_URL } from '@/config'
import { sitePath } from '@/lib/base'

const LINKS = [
  { href: sitePath('/#how'), label: 'How it works' },
  { href: sitePath('/#talent'), label: 'For talent' },
  { href: sitePath('/#companies'), label: 'For companies' },
  { href: GET_STARTED_URL, label: 'Get started', accent: true },
]
---

<footer
  class="site-footer mx-auto box-content max-w-[1120px] px-5 pb-[max(20px,env(safe-area-inset-bottom))] sm:px-8"
>
  {/* One column on small screens; two rows from 800px, the first width at which the four chips fit
      on one line beside the lockup. Gaps and paddings are 16px or more around the lockup: Espoo's
      clear space is 0.41 of the logo's height (16.4px at 40px), and the tagline's letters start a
      few pixels inside its line box. */}
  <div
    class:list={[
      'glass grid gap-5 p-5 sm:px-7 sm:py-6',
      'min-[800px]:grid-cols-[1fr_auto] min-[800px]:items-center min-[800px]:gap-x-8 min-[800px]:gap-y-4',
    ]}
  >
    <a href={sitePath('/')} class="footer-logo justify-self-start">
      <EspooLockup />
    </a>
    <p class="text-[15px] text-ink-soft min-[800px]:col-start-1 min-[800px]:row-start-2">
      Events, companies and talent that fit.
    </p>
    <nav aria-label="Footer" class="min-[800px]:col-start-2 min-[800px]:row-start-1">
      <ul class="flex flex-wrap gap-2 min-[800px]:justify-end">
        {
          LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={['footer-chip glass-chip', { 'footer-chip-accent': link.accent }]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="text-sm text-ink-soft min-[800px]:col-start-2 min-[800px]:row-start-2 min-[800px]:text-right">
      © 2026 Overlap
    </p>
  </div>
</footer>

<style>
  /* The page header's lockup: Espoo's navy, 32px high on phones and 40px from 640px. */
  .footer-logo {
    --espoo-lockup-height: 32px;
    display: inline-flex;
    border-radius: 4px;
    color: #012169;
    line-height: 1;
  }
  @media (min-width: 640px) {
    .footer-logo {
      --espoo-lockup-height: 40px;
    }
  }

  /* The hero's chips (.ask-chip): a quiet hover and press on the glass pill. */
  .footer-chip {
    text-decoration: none;
    transition:
      border-color 0.2s,
      background-color 0.2s,
      transform 0.15s;
  }
  .footer-chip:hover {
    border-color: color-mix(in srgb, var(--color-forest) 55%, transparent);
    background: var(--color-card);
  }
  .footer-chip:active {
    transform: scale(0.97);
  }
  /* Get started in the colours of the hero's send button, the page's one accent. The border stays,
     transparent, so the pill keeps the size of the others. */
  .footer-chip-accent,
  .footer-chip-accent:hover {
    border-color: transparent;
    color: var(--color-lime);
  }
  .footer-chip-accent {
    background: var(--color-forest);
  }
  .footer-chip-accent:hover {
    background: color-mix(in srgb, var(--color-forest) 86%, #000);
  }

  .footer-logo:focus-visible,
  .footer-chip:focus-visible {
    outline: 2px solid var(--color-forest);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-chip {
      transition: none;
    }
  }
</style>
