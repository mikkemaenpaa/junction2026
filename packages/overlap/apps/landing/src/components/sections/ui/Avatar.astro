---
// The app's avatar (apps/app/src/ui.tsx, Avatar): initials on a pale tint of the entity's hue.
// Companies are square (squircle), people round.
interface Props {
  name: string
  hue: number
  size?: number
  square?: boolean
  /** Extra classes, e.g. a ring to separate overlapping avatars. */
  class?: string
}

const { name, hue, size = 40, square = false, class: className } = Astro.props
const initials = name
  .split(' ')
  .map((word) => word[0])
  .slice(0, 2)
  .join('')
---

<span
  class:list={[
    'grid shrink-0 place-items-center font-display leading-none font-bold',
    square ? 'squircle-md' : 'rounded-full',
    className,
  ]}
  style={`width:${size}px;height:${size}px;background:hsl(${hue} 55% 88%);color:hsl(${hue} 60% 22%);font-size:${Math.round(size * 0.36)}px`}
  >{initials}</span
>
