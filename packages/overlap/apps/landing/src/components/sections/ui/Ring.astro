---
// The app's fit ring (apps/app/src/ui.tsx, Ring) as static markup: a 0-100 arc with the value in
// the middle. On forest (dark) it is lime on a faint white track, as in the app.
interface Props {
  value: number
  size?: number
  dark?: boolean
}

const { value, size = 48, dark = false } = Astro.props
const r = size / 2 - 5
const c = 2 * Math.PI * r
// The app grades the arc by band; 80+ is its green ("good"). Lower bands map onto the palette.
const arc = dark ? 'stroke-lime' : value >= 80 ? 'stroke-good' : value >= 50 ? 'stroke-forest' : 'stroke-coral'
---

<span class="relative grid shrink-0 place-items-center" style={`width:${size}px;height:${size}px`}>
  <svg class="absolute inset-0 -rotate-90" width={size} height={size} viewBox={`0 0 ${size} ${size}`} aria-hidden="true">
    <circle
      class={dark ? 'stroke-white/15' : 'stroke-line'}
      cx={size / 2}
      cy={size / 2}
      r={r}
      fill="none"
      stroke-width="5"></circle>
    <circle
      class={arc}
      cx={size / 2}
      cy={size / 2}
      r={r}
      fill="none"
      stroke-width="5"
      stroke-linecap="round"
      stroke-dasharray={c.toFixed(2)}
      stroke-dashoffset={(c * (1 - value / 100)).toFixed(2)}></circle>
  </svg>
  <span
    class:list={['relative font-display leading-none font-bold tabular-nums', dark && 'text-white']}
    style={`font-size:${Math.round(size * 0.3)}px`}>{value}</span
  >
</span>
