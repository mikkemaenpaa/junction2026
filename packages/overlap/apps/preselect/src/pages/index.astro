---
// Organiser view. The applicants and companies are read on every request and handed to the
// page, which scores them in the browser.
import Organizer from "../components/Organizer.tsx";
import Layout from "../layouts/Layout.astro";
import { prepareCompanies } from "../lib/companies.ts";
import { readApplicants, readCompanies } from "../lib/store.ts";
import { toView } from "../lib/view.ts";

const companies = readCompanies();
const prepared = prepareCompanies(companies);
const applicants = readApplicants().map((applicant) => toView(applicant, prepared));
---

<Layout title="Suggested applicants · Preselect">
  <Organizer client:load applicants={applicants} companies={companies} />
</Layout>
